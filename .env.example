# ============================================
# DISCORD
# ============================================
DISCORD_TOKEN="TU_TOKEN_DE_DISCORD_AQUI"

# --- Canales de Discord (Ruleta) ---
DISCORD_CHANNEL_ID_KUPYO="ID_DEL_CANAL_KUPYO"
DISCORD_CHANNEL_ID_HERALD="ID_DEL_CANAL_HERALD"
DISCORD_REPORT_CHANNEL_ID_KUPYO="ID_DEL_CANAL_REPORTES_KUPYO"
DISCORD_REPORT_CHANNEL_ID_HERALD="ID_DEL_CANAL_REPORTES_HERALD"

# ============================================
# MONGODB (Ruleta - historial de dailys)
# ============================================
MONGO_URI="mongodb+srv://usuario:password@cluster.mongodb.net/dbname"

# ============================================
# GOOGLE APPS SCRIPT (Calendario de dailys)
# ============================================
GAS_WEB_APP_URL="https://script.google.com/macros/s/TU_SCRIPT_ID/exec"

# ============================================
# GOOGLE AI (Gemini) - LLM principal
# ============================================
# Opcion A: API Key de Google AI Studio (recomendado - mas simple y economico)
GOOGLE_API_KEY="TU_API_KEY_AQUI"
GEMINI_MODEL="gemini-2.5-flash"

# Opcion B: Vertex AI (GCP) - Solo si no usas GOOGLE_API_KEY
# Si GOOGLE_API_KEY esta seteada, tiene prioridad sobre Vertex AI.
# GOOGLE_CLOUD_PROJECT_ID="tu-proyecto-gcp"
# GOOGLE_CLOUD_REGION="us-central1"

# ============================================
# CLICKUP
# ============================================
CLICKUP_API_KEY="pk_TU_API_KEY_DE_CLICKUP"
# Spaces donde el bot busca la carpeta "Testing Repository"
CLICKUP_HERALD_SPACE_ID="SPACE_ID"
CLICKUP_KUPYO_SPACE_ID="SPACE_ID"
# ID del Custom Task Type "Test Case" (para el icono correcto)
CLICKUP_TEST_CASE_TYPE_ID="1002"
# Lista por defecto donde crear los test cases (opcional)
# CLICKUP_LIST_ID="LIST_ID"

# ============================================
# JIRA (Opcional)
# ============================================
JIRA_URL="https://tu-instancia.atlassian.net"
JIRA_USER="tu-email-de-jira@dominio.com"
JIRA_API_TOKEN="TU_API_TOKEN_DE_JIRA"
DEFAULT_PROJECT_KEY="PROJ"

